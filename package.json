{
    "name": "obsidian-vault-dashboard",
    "version": "1.0.0",
    "description": "Desktop dashboard for visualizing Obsidian vault tasks and experiments",
    "main": "main.js",
    "scripts": {
        "start": "electron .",
        "build": "electron-builder",
        "build:mac": "electron-builder --mac",
        "build:win": "electron-builder --win",
        "build:linux": "electron-builder --linux"
    },
    "keywords": [
        "obsidian",
        "dashboard",
        "project-management",
        "electron"
    ],
    "author": "Arjun Karuvally",
    "license": "MIT",
    "devDependencies": {
        "electron": "^28.0.0",
        "electron-builder": "^24.9.1"
    },
    "dependencies": {
        "chokidar": "^3.5.3",
        "electron-store": "^8.1.0"
    },
    "build": {
        "appId": "com.obsidian.vault.dashboard",
        "productName": "Obsidian Vault Dashboard",
        "directories": {
            "output": "dist"
        },
        "files": [
            "main.js",
            "preload.js",
            "index.html",
            "kanban.html",
            "app.js",
            "kanban.js",
            "style.css",
            "kanban.css",
            "node_modules/**/*"
        ],
        "mac": {
            "category": "public.app-category.productivity",
            "target": [
                "dmg",
                "zip"
            ]
        },
        "win": {
            "target": [
                "nsis",
                "portable"
            ]
        },
        "linux": {
            "target": [
                "AppImage",
                "deb"
            ],
            "category": "Utility"
        }
    }
}